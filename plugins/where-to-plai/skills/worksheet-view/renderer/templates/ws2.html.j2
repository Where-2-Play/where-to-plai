{% import '_macros.html.j2' as m %}
{%- set ARROW %}<span style="margin-left: 0.5rem;"><svg fill="none" height="6" viewbox="0 0 10 6" width="10" xmlns="http://www.w3.org/2000/svg"><path d="M5 6L.67 0h8.66L5 6z" fill="#00AEEF"></path></svg></span>{% endset -%}
{%- set ARROWICON %}<svg class="arrow-icon" height="90px" version="1.1" viewbox="0 0 52 90" width="52px" xmlns="http://www.w3.org/2000/svg"><g fill="none" fill-rule="evenodd" id="Page-1" stroke="none" stroke-width="2"><polyline id="Path" points="1 19 1 3 50 45 1 87 1 71" stroke="#979797" stroke-width="2"></polyline></g></svg>{% endset -%}
{%- set NOTEICON %}<svg cursor="pointer" fill="none" height="24" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z" stroke="#000" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke="#000" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>{% endset -%}
{%- macro scale(start) -%}
<div class="arrow-component">{% for k in range(8) %}<div class="arrow-section{% if k == start or k == start + 1 %} filled{% endif %}"></div>{% endfor %}{{ ARROWICON }}<div class="levels-text"><div class="align-mid">Low</div><div class="align-mid">Mid</div><div class="align-mid">High</div><div class="align-mid">Super High</div></div></div>
{%- endmacro -%}
{%- macro attr(icon, heading, infos, start) -%}
<div class="attractiveness-section"><div class="section-icon"><img alt="heading" src="assets/icons/{{ icon }}"/></div><div class="section-evaluate">{{ scale(start) }}<div class="section-heading">{{ heading }}</div>{% for t in infos %}<div class="info-text">{{ t }}</div>{% endfor %}</div><div class="section-comment"><div class="comment-origin"><div class="comment-origin__icon">{{ NOTEICON }}</div><div class="comment-origin__text">Add a note</div></div></div></div>
{%- endmacro -%}
{%- set POT = [
  ('potential-1.png','Compelling reason to buy',['Unmet need','Effective solution','Better than current solutions'],'reasonToBuy'),
  ('potential-2.png','Market volume',['Current market size','Expected growth'],'marketVolume'),
  ('potential-3.png','Economic viability',['Margins (value vs. cost)','Customers’ ability to pay','Customer stickiness'],'economicViability')] -%}
{%- set CHA = [
  ('challenge-1.png','Implementation obstacles',['Product development difficulties','Sales and distribution difficulties','Funding challenges'],'implementationObstacles'),
  ('challenge-2.png','Time to revenue',['Development time','Time between product and market readiness','Length of sale cycle'],'timeToRevenue'),
  ('challenge-3.png','External risks',['Competitive threat','3rd party dependencies','Barriers to adoption'],'externalRisks')] -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Where to Play — Worksheet 2 — Attractiveness Map</title>
<link rel="stylesheet" href="css/bootstrap.css">
<link rel="stylesheet" href="css/app.css">
<style>.ws2-native-select{position:absolute;left:0;top:0;width:100%;height:100%;opacity:0;cursor:pointer;border:0;}</style>
</head>
<body class="wtp-static">
<div id="root"><div class="page"><div class="projects-loading" data-active="false"><div class="projects-loading__title">Loading ..</div></div><main class="page-content">{{ m.nav('ws2') }}<div class=""><div class="worksheet-page"><div class="page-title"><div class="info-text">Use this worksheet for every market opportunity you would like to evaluate. Navigate between opportunities through the drop down menu.</div></div><div class="worksheet-page2"><div class="select-section" style="position: relative;"><img alt="opportunity" src="assets/icons/box-icon.png"/><span>Market Opportunity:</span><span class="select-dropdown fix" style="line-height: 1.2rem;"><span><span class="dropdown-repair-worksheet3 dropdown-title opportunity-select dropdown-title-primary" style="font-size: 1.2rem; line-height: 1.6rem;"><span id="ws2-title-text">{% if ws2_opps %}{{ ws2_opps[0].app }} - {{ ws2_opps[0].customer }}{% endif %}</span>{{ ARROW }}</span></span></span>{% if ws2_opps|length > 1 %}<select class="ws2-native-select" id="ws2-select">{% for o in ws2_opps %}<option>{{ o.app }} - {{ o.customer }}</option>{% endfor %}</select>{% endif %}</div>{% for o in ws2_opps %}<div class="ws2-block"{% if not loop.first %} style="display:none"{% endif %}><div class="evaluate-section" data-transparent="false"><div class="row"><div class="col-sm-6 potential-section section-border"><div class="section-title">Potential</div><img alt="question-mark" class="question-mark-icon" id="Tooltip-attract-1" src="assets/icons/question-mark.png"/>{% for icon, heading, infos, key in POT %}{{ attr(icon, heading, infos, o.factors.get(key, 0)) }}{% endfor %}</div><div class="col-sm-6 challenge-section section-border-right"><div class="section-title">Challenge</div><img alt="question-mark" class="question-mark-icon" id="Tooltip-attract-2" src="assets/icons/question-mark.png"/>{% for icon, heading, infos, key in CHA %}{{ attr(icon, heading, infos, o.factors.get(key, 0)) }}{% endfor %}</div></div></div><div class="overall-section"><div class="row h-padding-bottom"><div class="col-sm-6"><div class="overall"><div class="section-title">Overall potential</div>{{ scale(o.overallPotentialStart) }}</div><span class="overall-image"><img alt="overall-potential" src="assets/icons/overall-potential.png"/></span></div><div class="col-sm-6"><div class="overall"><div class="section-title">Overall challenge</div>{{ scale(o.overallChallengeStart) }}</div><span class="overall-image"><img alt="overall-challenge" src="assets/icons/overall-challenge.png"/></span></div></div></div></div>{% endfor %}</div></div><div class="bottom-line"><a href="/"><img alt="Worksheet 2" src="assets/images/attractiveness-map.png"/></a><div class="bottom-text">Once you have rated the overall Potential and Challenge of a market opportunity, it will automatically be positioned on the Attractiveness Map</div></div></div></div>{{ m.notes() }}</main></div></div>
<script>(function(){var s=document.getElementById('ws2-select');if(!s)return;var t=document.getElementById('ws2-title-text');var b=document.querySelectorAll('.ws2-block');s.addEventListener('change',function(){var i=s.selectedIndex;b.forEach(function(x,j){x.style.display=j===i?'':'none';});if(t)t.textContent=s.options[i].text;});})();</script>
{{ m.navscript() }}
</body>
</html>

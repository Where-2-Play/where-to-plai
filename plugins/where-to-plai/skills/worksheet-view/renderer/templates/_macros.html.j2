{# Shared shell: nav bar, notes placeholder, nav-switch script. #}
{%- macro _qm() -%}<img alt="question-mark" class="question-mark-icon" id="tooltip" src="assets/icons/question-mark.png"/>{%- endmacro -%}
{%- macro nav(active) -%}
<div class="navigation-section-container"><div class="left-navigation print-hide"><span class="line"></span><div class="navigation-section overview{% if active == 'overview' %} active{% endif %}"><div class="gray-box"></div><a href="/" style="position: relative; z-index: 1;"><div class="navigation-item-center"><img alt="heading" class="overview-fix-height" src="assets/images/overview.png"/><div class="navigation-container"><div class="navigation-item navigation-heading">MARKET OPPORTUNITY NAVIGATOR</div>{% if active == 'overview' %}{{ _qm() }}{% endif %}</div></div></a></div><span class="line"></span><div class="navigation-section{% if active == 'ws1' %} active{% endif %}"><div class="gray-box"></div><a href="/worksheet-1" style="position: relative; z-index: 1;"><div class="navigation-item-center"><img alt="heading" src="assets/images/opportunity-set.png"/><div class="navigation-container"><div class="worksheet-title">Worksheet 1</div><div class="navigation-item navigation-heading">MARKET OPPORTUNITY SET</div>{% if active == 'ws1' %}{{ _qm() }}{% endif %}</div></div></a></div><span class="line"></span><div class="navigation-section{% if active == 'ws2' %} active{% endif %}"><div class="gray-box"></div><a href="/worksheet-2" style="position: relative; z-index: 1;"><div class="navigation-item-center"><img alt="heading" src="assets/images/attractiveness-map.png"/><div class="navigation-container"><div class="worksheet-title">Worksheet 2</div><div class="navigation-item navigation-heading">ATTRACTIVENESS MAP</div>{% if active == 'ws2' %}{{ _qm() }}{% endif %}</div></div></a></div><span class="line"></span><div class="navigation-section{% if active == 'ws3' %} active{% endif %}"><div class="gray-box"></div><a href="/worksheet-3" style="position: relative; z-index: 1;"><div class="navigation-item-center"><img alt="heading" src="assets/images/agile-focus.png"/><div class="navigation-container"><div class="worksheet-title">Worksheet 3</div><div class="navigation-item navigation-heading">AGILE FOCUS DARTBOARD</div>{% if active == 'ws3' %}{{ _qm() }}{% endif %}</div></div></a></div><span class="line"></span></div></div>
{%- endmacro -%}

{%- macro notes() -%}
<div class="notes-container"><div class=""></div><div class="notes-section hidden-notes"><div class="cross"><div class="close-notes__btn"><span></span></div></div><div class="notes-flex-base-container"><div class="notes-flex-item note"></div><div class="notes-flex-item text">Notes</div></div><div class="rect-container"><div class="rect"></div></div><div class="notes-content-comment"></div><div class="notes-content-textarea"><div class="notes-content"><textarea cols="40" id="notes" name="notes" placeholder="Your note goes here" rows="10"></textarea><button class="styled-button">Add note</button></div></div></div></div><div class="comment-list" hidden=""><div class="comment-list__close"></div><div class="comment-list__container"><div class="comment-list__content"><div class="comment-list__head"><div class="comment-list__cross"></div><div class="comment-list__top"><div class="comment-list__bubble"></div><div class="comment-list__title">Notes <span class="comment-list__count">(0)</span></div></div><div class="comment-list__bottom"></div></div><div class="comment-list__list"></div></div><div class="comment-list__input"><textarea class="comment-list__textarea" placeholder="Your note goes here"></textarea><button class="comment-list__send">Add a note</button></div></div></div>
{%- endmacro -%}

{%- macro navscript() -%}
<script>(function(){var files=['overview.html','ws1.html','ws2.html','ws3.html'];var nav=document.querySelectorAll('.left-navigation .navigation-section');nav.forEach(function(n,i){n.style.cursor='pointer';n.addEventListener('click',function(e){e.preventDefault();if(files[i])location.href=files[i];});});})();</script>
{%- endmacro -%}

{% import '_macros.html.j2' as m %}
{%- set ARROW %}<span style="margin-left: 0.5rem;"><svg fill="none" height="6" viewbox="0 0 10 6" width="10" xmlns="http://www.w3.org/2000/svg"><path d="M5 6L.67 0h8.66L5 6z" fill="#00AEEF"></path></svg></span>{% endset -%}
{%- macro relrow(active) -%}
<div class="selection-boxes">{% for i in range(3) %}{% if i == active %}<div class="box active"><span class="circle-image"><span class="circle-image-{{ i+1 }}"><span class="circle-active"></span><span class="circle-active" id="circle2"></span></span></span></div>{% else %}<div class="box false"><span class="circle-image"><span class="circle-image-{{ i+1 }}"><span class="circle"></span><span class="circle" id="circle2"></span></span></span></div>{% endif %}{% endfor %}</div>
{%- endmacro -%}
{%- macro agilerow(active) -%}
<div class="selection-boxes">{% for label, key in [('Pursue now','pursueNow'),('Keep open','keepOpen'),('Place in storage','placeInStorage')] %}<div class="box {% if active == key %}active{% else %}false{% endif %}"><span>{{ label }}</span></div>{% endfor %}</div>
{%- endmacro -%}
{%- macro candidate(c) -%}
<div class="col-sm-4 select-opportunity-section"><div class="row section-row bb-md bt-lg"><div class="selection-container col-sm-12 white-bg br-md pt-3"><div class="arrow"></div>{% if c.empty %}<img alt="delete" class="delete-icon" src="assets/icons/add-icon.png"/>{% endif %}<span><img alt="opportunity" class="box-icon" src="assets/icons/box-icon.png" style="vertical-align: top;"/><span class="select-dropdown fix" style="line-height: 1.6rem;"><span><span class="dropdown-repair-worksheet3 dropdown-title opportunity-select dropdown-title-black" style="font-size: 1.6rem; line-height: 2rem;">{% if not c.empty %}{{ c.app }} - {{ c.customer }}{% endif %}{{ ARROW }}</span></span></span></span></div></div><div class="row section-row bb-sm"><div class="col-sm-12 white-bg br-md v-align h-align">{{ relrow(c.product if c.product is not none else -1) }}</div></div><div class="row section-row bb-md"><div class="col-sm-12 white-bg br-md v-align h-align">{{ relrow(c.market if c.market is not none else -1) }}</div></div><div class="row section-row bb-sm"><div class="col-sm-12 white-bg br-md v-align"><div class="checkbox-wrapper"><span><div class="checkbox-element"><input {% if c.backup %}checked="checked" {% endif %}class="checkbox" readonly="" type="checkbox"/><span></span></div><span class="label">Backup</span></span></div></div></div><div class="row section-row"><div class="col-sm-12 white-bg br-md v-align"><div class="checkbox-wrapper"><span><div class="checkbox-element"><input {% if c.growth %}checked="checked" {% endif %}class="checkbox" readonly="" type="checkbox"/><span></span></div><span class="label">Growth</span></span></div></div></div><div class="row section-row bt-lg"><div class="col-sm-12 white-bg br-md v-align h-align"><div class="arrow"></div><span>{{ agilerow(c.agile) }}</span></div></div></div>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Where to Play — Worksheet 3 — Agile Focus Dartboard</title>
<link rel="stylesheet" href="css/bootstrap.css">
<link rel="stylesheet" href="css/app.css">
</head>
<body class="wtp-static">
<div id="root"><div class="page"><div class="projects-loading" data-active="false"><div class="projects-loading__title">Loading ..</div></div><main class="page-content">{{ m.nav('ws3') }}<div class=""><div class="worksheet-page"><div class="page-title"><div class="info-text">Build a smart portfolio around your Primary Market Opportunity to mitigate your risk and increase your value.</div></div><div class="worksheet-page3"><div class="row section-row-sm"><div class="col-sm-3"><img alt="question-mark" class="question-mark-icon" id="Tooltip-agile-1" src="assets/icons/question-mark.png"/><div class="section-text"><div class="row"><div class="col-sm-1 number">I.</div><div class="col-sm-11 text">Choose a Primary Market Opportunity to focus on (based on the Attractiveness Map).</div></div></div></div><div class="selection-container col-sm-9 white-bg radius-bl radius-br pt-3"><img alt="opportunity" class="box-icon" src="assets/icons/box-icon.png"/><span class="select-dropdown fix" style="line-height: 1.6rem;"><span><span class="dropdown-repair-worksheet3 dropdown-title opportunity-select dropdown-title-primary" style="font-size: 1.6rem; line-height: 2rem;">{% if primary %}{{ primary.application }} - {{ primary.customer }}{% endif %}{{ ARROW }}</span></span></span></div></div><div class="select-section row" data-transparent="false"><div class="col-sm-3"><div class="row section-row bb-md bt-lg"><div class="col-sm-12"><img alt="question-mark" class="question-mark-icon" id="Tooltip-agile-2" src="assets/icons/question-mark.png"/><div class="section-text"><div class="row"><div class="col-sm-1 number">II.</div><div class="col-sm-11 text">Pick other attractive market opportunities from your set to examine possible Backup and Growth Options.</div></div></div></div></div><div class="row section-row bb-sm"><div class="col-sm-12 white-bg br-md v-align"><span class="section-text"><p class="section-text-intro">Relatedness to your Primary Market Opportunity:</p><span class="section-heading">PRODUCT RELATEDNESS</span><br/>To what extent do the products share:<br/> technological competences, required resources, necessary networks</span></div></div><div class="row section-row bb-md"><div class="col-sm-12 white-bg br-md v-align"><span class="section-text"><span class="section-heading">MARKET RELATEDNESS</span><br/> To what extent do the customers share:<br/> values and benefits, sales channels, word-of-mouth</span></div></div><div class="row section-row bb-sm"><div class="col-sm-12 white-bg br-md v-align"><span class="section-text"><p class="section-text-intro">Suitable as:</p><span class="section-heading">BACKUP OPTION</span><br/> Attractive market opportunities that do not share major risks with your Primary Market Opportunity to allow for a change in direction</span></div></div><div class="row section-row"><div class="col-sm-12 white-bg br-md d-flex v-align radius-bl"><span class="section-text"><span class="section-heading">GROWTH OPTION</span><br/> Attractive market opportunities that allow your business to create additional value</span></div></div><div class="row section-row bt-lg"><div class="col-sm-12"><img alt="question-mark" class="question-mark-icon" id="Tooltip-agile-3" src="assets/icons/question-mark.png"/><div class="section-text"><div class="row"><div class="col-sm-1 number with-line-height">III.</div><div class="col-sm-11 text"><span class="section-text-title">Design your Agile Focus Strategy:</span> <ul><li>Keep at least one Backup and one Growth Option open</li><li>Decide if any option is worth pursuing now</li><li>Place the rest in storage</li></ul></div></div></div></div></div></div><div class="col-sm-9"><div class="row opportunities-section">{% for c in candidates %}{{ candidate(c) }}{% endfor %}{% for _ in range(ws3_empty) %}{{ candidate({'empty': True, 'product': none, 'market': none, 'backup': False, 'growth': False, 'agile': none}) }}{% endfor %}</div><div class="adder"><img alt="add" class="add-icon" id="Tooltip-undefined" src="assets/icons/add-icon.png"/><div class="counter">{{ candidates|length + ws3_empty }} / 8</div></div></div></div></div><div class="bottom-line"><a href="/"><img alt="Worksheet 3" src="assets/images/agile-focus.png"/></a><div class="bottom-text">Once you complete this worksheet, your strategy will be automatically depicted on the Agile Focus Dartboard</div></div></div></div>{{ m.notes() }}</main></div></div>
{{ m.navscript() }}
</body>
</html>

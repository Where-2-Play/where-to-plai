{% import '_macros.html.j2' as m %}
{%- set DELSVG %}<svg fill="none" height="16" viewbox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg"><path class="on-mouse-over-svg" d="M2 4h12M5.333 4V2.667a1.333 1.333 0 011.334-1.334h2.666a1.334 1.334 0 011.334 1.334V4m2 0v9.333a1.334 1.334 0 01-1.334 1.334H4.667a1.333 1.333 0 01-1.334-1.334V4h9.334zM6.667 7.333v4M9.333 7.333v4" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.333"></path></svg>{% endset -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Where to Play — Worksheet 1 — Market Opportunity Set</title>
<link rel="stylesheet" href="css/bootstrap.css">
<link rel="stylesheet" href="css/app.css">
<style>.wtp-static .opportunity-section{height:auto;min-height:35rem}.wtp-static .opportunity-section .customer-section{height:auto;min-height:30rem;padding-bottom:1rem}.wtp-static .segment-input.sub{padding-left:1.6rem}.wtp-static .segment-input.sub input{width:calc(75% - 1.6rem)}.wtp-static .segment-input.wtp-out input{opacity:.45;text-decoration:line-through}.wtp-static .segment-input.wtp-parked input{opacity:.7;font-style:italic;outline:1px dashed #999;outline-offset:-1px}.wtp-static .segment-input.wtp-out::after,.wtp-static .segment-input.wtp-parked::after{position:absolute;left:calc(75% + 1rem);top:50%;transform:translateY(-50%);font-size:.9rem;color:#888}.wtp-static .segment-input.wtp-out::after{content:"out"}.wtp-static .segment-input.wtp-parked::after{content:"parked"}.wtp-legend{font-size:1rem;color:#666;margin-top:.5rem}.wtp-legend span{display:inline-block;padding:0 .4rem;margin:0 .3rem}</style>
</head>
<body class="wtp-static">
<div id="root"><div class="page"><div class="projects-loading" data-active="false"><div class="projects-loading__title">Loading ..</div></div><main class="page-content">{{ m.nav('ws1') }}<div class=""><div class="worksheet-page"><div class="page-title"></div><div class="worksheet-page1"><div class="section-title">Abilities</div><div class="section-title">Applications</div><div class="section-title">Customers</div><div class="worksheet-title ability"><img alt="question-mark" class="question-mark-icon" id="Tooltip-market-1" src="assets/icons/question-mark.png"/><div class="title-content"><div class="main-heading">List the venture’s core abilities or technological elements</div><div class="sub-heading">Characterize them based on their functions and properties. Describe them in a general manner, independent from your (envisioned) product.</div></div></div><div class="helper-wrapper" style="overflow: visible; position: relative;"><div class="abilities-wrapper"><div class="abilities-section"><div class="row ability-row">{% for ab in abilities %}<div class="col-sm-3 col-without-padding"><div class="ability-section"><div class="ability-title-section"><img alt="gear" src="assets/icons/gear.png"/><input class="ability-title" maxlength="50" spellcheck="false" value="{{ ab.title }}"/></div><div class="bottom-border"></div>{% for r in ab.rows %}<input maxlength="50" spellcheck="false" value="{{ r }}"/>{% endfor %}</div></div>{% endfor %}</div></div><div class="adder"><img alt="add" class="add-icon" id="Tooltip-abilities" src="assets/icons/add-icon.png"/><div class="counter">{{ abilities|length }} / 8</div></div></div><div class="arrow"></div></div><div class="worksheet-title identify"><img alt="question-mark" class="question-mark-icon" id="Tooltip-market-2" src="assets/icons/question-mark.png"/><div class="title-content"><div class="main-heading">Identify your market opportunities</div><div class="sub-heading">Which applications can you offer with your core abilities? Which customers may need them? Zoom in to further segment each customer group.</div></div></div><div class="opportunities-section__wrapper"><div class="opportunities-section"><div class="row row-without-margin">{% for c in ws1_cols %}<div class="col-sm-4 col-without-padding"><div class="opportunity-section"><div class="applications-section"><div class="arrow"></div><img alt="box" src="assets/icons/box.png"/><input class="application-input" maxlength="50" value="{{ c.title }}"/>{% if c.deletable %}<img alt="delete" class="delete-icon" src="assets/icons/add-icon.png"/>{% endif %}</div><div class="customer-section"><img alt="customers" src="assets/icons/customers-icon.png"/>{% for n in c.segments %}<div class="customer-input segment-input set {{ status_class.get(n.status, '') }}"><input class="{% if n.status == 'onSet' %}is-on-set{% endif %}" maxlength="50" placeholder="Type customer segment here" value="{{ n.text }}"/><div class="segment-menu"><div class="delete-section">{{ DELSVG }}</div></div></div>{% for sub in n.subs %}<div class="sub segment-input {{ status_class.get(sub.status, '') }}"><input class="{% if sub.status == 'onSet' %}is-on-set{% endif %}" maxlength="50" placeholder="Type sub segment here" value="{{ sub.text }}"/></div>{% endfor %}{% if n.hasSub and not n.subs %}<div class="sub segment-input"><input maxlength="50" placeholder="Type sub segment here"/></div>{% endif %}{% endfor %}<div class="customer-input segment-input"><input maxlength="50" placeholder="Type customer segment here"/></div></div></div></div>{% endfor %}</div></div><div class="adder"><img alt="add" class="add-icon" id="Tooltip-opportunities" src="assets/icons/add-icon.png"/><div class="counter">{{ ws1_cols|length }} / 6</div></div></div><div class="opportunity-equation"><span class="application part"><img alt="box" src="assets/icons/box.png"/><span>application</span><span>+</span></span><span class="customer part"><img alt="customer" src="assets/icons/customer.png"/><span>customer</span><span>=</span></span><span class="opportunity part"><img alt="box-icon" src="assets/icons/box-icon.png"/><span>market opportunity</span></span></div>{% if ws1_legend %}<div class="wtp-legend">Market opportunities: <span class="is-on-set" style="background-color:#f2ee93">on the set</span><span style="opacity:.45;text-decoration:line-through">screened out</span><span style="opacity:.7;font-style:italic;outline:1px dashed #999">parked</span></div>{% endif %}</div><div class="bottom-line"><a href="/"><img alt="Worksheet 1" src="assets/images/opportunity-set.png"/></a><div class="bottom-text">Click on  the markets that you would like to further investigate to send them into your Market Opportunity Set.</div></div></div></div>{{ m.notes() }}</main></div></div>
{{ m.navscript() }}
</body>
</html>
